{
  "name": "@club-athletic/managed-agents",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test",
    "test": "bun --no-env-file test",
    "validate": "bun --no-env-file scripts/validate.ts",
    "deploy": "bash scripts/deploy.sh",
    "deploy:agents": "bash scripts/deploy-agents.sh",
    "deploy:skills": "bash scripts/deploy-skills.sh"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  }
}
