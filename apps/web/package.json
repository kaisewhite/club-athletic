{
  "name": "club-athletic-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun --watch index.ts",
    "start": "bun index.ts",
    "prebuild": "react-router typegen",
    "build": "react-router build && tsc --noEmit",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint app src server tests index.ts vite.config.ts vitest.config.ts react-router.config.ts",
    "test": "vitest run --project unit --project dom --passWithNoTests",
    "test:agent:live": "bun run build && bun tests/integration/live-trip-read-tools.ts && playwright test --config playwright.live.config.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "db:generate": "bash scripts/with-env.sh bunx prisma generate",
    "db:migrate:deploy": "bash scripts/with-env.sh bunx prisma migrate deploy",
    "db:migrate:dev": "bash scripts/with-env.sh bash scripts/migrate-dev.sh",
    "db:seed": "bash scripts/with-env.sh bun prisma/seed.ts",
    "db:studio": "bash scripts/with-env.sh bunx prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@react-router/express": "7.18.1",
    "@react-router/node": "7.18.1",
    "@tanstack/react-table": "9.2.4",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "file-type": "22.0.2",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "20.1.2",
    "react-router": "7.18.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@react-router/dev": "7.18.1",
    "@tailwindcss/vite": "4.1.13",
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "happy-dom": "20.11.1",
    "oxlint": "1.85.0",
    "prisma": "7.8.0",
    "tailwindcss": "4.1.13",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
