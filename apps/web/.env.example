ANTHROPIC_API_KEY=
VAULT_ID=
# Neon. Use `sslmode=verify-full` explicitly: pg-connection-string currently
# treats `require` as an alias for `verify-full`, but in pg-connection-string
# v3 / pg v9 it adopts weaker libpq semantics that skip certificate
# verification. Keep `channel_binding=require` alongside it.
# e.g. postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require
DATABASE_URL=
DATABASE_URL_POOLED=

CLAUDE_MANAGED_ENVIRONMENT_ID=

CLAUDE_TRIP_AGENT_ID=

# Optional. Written by apps/managed-agents/scripts/deploy.sh into scripts/.state/trip-memory.id.
CLAUDE_TRIP_MEMORY_STORE_ID=
